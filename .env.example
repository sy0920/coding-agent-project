# 复制本文件为 .env 并填入真实密钥（.env 已在 .gitignore 中，不会入库）
# 也可直接用环境变量：export DEEPSEEK_API_KEY=sk-xxxx

# 必填：DeepSeek API 密钥
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 以下均为可选，括号内为默认值
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096
# AGENT_WORKSPACE=./workspace
# AGENT_MAX_ITERATIONS=30
# AGENT_MAX_CONTEXT_TOKENS=60000
# AGENT_COMMAND_TIMEOUT=60
